modules = ["nodejs-24", "python-3.11", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true
integrations = ["google-mail:1.0.0"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 90000

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 8081

[[ports]]
localPort = 8082
externalPort = 3003

[[ports]]
localPort = 19186
externalPort = 3001

[[ports]]
localPort = 19187
externalPort = 3002

[[ports]]
localPort = 24586
externalPort = 3000

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]

[userenv.development]
VITE_TURNSTILE_SITE_KEY = "1x00000000000000000000AA"

[userenv.production]
VITE_TURNSTILE_SITE_KEY = "0x4AAAAAADLpUK3jNdLg8rvm"
